<div class="card mb-3">
    <div class="card-header">
        <h2 class="card-title">
            {{ 'sylius.ui.general'|trans }}
        </h2>
    </div>
    <div class="card-body">
        {# Render standard general fields via hook #}
        {% hook 'general' %}

        {# Render our extended global fields if present on the form #}
        {% set form = hookable_metadata.context.form %}
        <div class="row g-3 mt-2">
            {% if form.visibleInMenu is defined %}
                <div class="col-12 col-md-6">{{ form_row(form.visibleInMenu) }}</div>
            {% endif %}
            {% if form.template is defined %}
                <div class="col-12 col-md-6">{{ form_row(form.template) }}</div>
            {% endif %}
            {% if form.seoData is defined %}
                <div class="col-12">{{ form_row(form.seoData) }}</div>
            {% endif %}
            {% if form.merchandising is defined %}
                <div class="col-12">{{ form_row(form.merchandising) }}</div>
            {% endif %}
        </div>
    </div>
</div>
